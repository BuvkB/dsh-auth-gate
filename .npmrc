registry=https://registry.npmjs.org/
# The lockfile is generated against the public registry and must stay that
# way (enforced by `npm run lock:check`). `never` forbids npm from rewriting
# resolved hosts to a locally configured internal mirror (this machine sets
# NPM_CONFIG_REGISTRY at the environment level). When adding/updating deps,
# always run `npm install --registry=https://registry.npmjs.org/`.
replace-registry-host=never
