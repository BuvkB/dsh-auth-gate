registry=https://registry.npmjs.org/
# CI runners cannot reach the internal Nexus that generated this lockfile;
# local installs are forced to it by the machine-level NPM_CONFIG_REGISTRY.
# `always` makes npm rewrite the lockfile's registry host to the effective
# registry (npmjs on CI, Nexus locally) — one lockfile works in both places.
replace-registry-host=always
